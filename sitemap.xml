---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | where_exp: "page", "page.sitemap != false and page.url != '/sitemap.xml'" %}
{% for page in pages %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
  </url>
{% endfor %}
{% for collection in site.collections %}
{% assign documents = collection.docs | where_exp: "document", "document.sitemap != false" %}
{% for document in documents %}
  <url>
    <loc>{{ document.url | absolute_url }}</loc>
  </url>
{% endfor %}
{% endfor %}
</urlset>
